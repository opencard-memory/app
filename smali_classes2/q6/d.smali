.class public final Lq6/d;
.super Lo5/g;
.source "FinderPattern.java"


# instance fields
.field public final c:F

.field public final d:I


# direct methods
.method public constructor <init>(FFF)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lo5/g;-><init>(FF)V

    iput p3, p0, Lq6/d;->c:F

    const/4 p1, 0x1

    iput p1, p0, Lq6/d;->d:I

    return-void
.end method

.method public constructor <init>(FFFI)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lo5/g;-><init>(FF)V

    iput p3, p0, Lq6/d;->c:F

    iput p4, p0, Lq6/d;->d:I

    return-void
.end method
